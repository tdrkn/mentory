@startuml

skinparam linetype ortho
top to bottom direction
skinparam defaultFontSize 12
skinparam ArrowFontSize 11
skinparam nodesep 70
skinparam ranksep 95

title Mentory ER (Пользовательская часть / актуальный modular monolith MVP)

' As-is implementation ER.
' Последний DOCX-отчет содержит упрощенные logical tables с Integer ID.
' Эта диаграмма намеренно следует текущей Prisma schema: UUID, timestamptz,
' subscriptions/workspace/credits, attachments и session-as-request flow.

entity "users" as users {
  * id : UUID <<PK>>
  --
  email : text <<UQ>>
  username : text <<UQ, nullable>>
  full_name : text
  avatar_url : text <<nullable>>
  role : text
  is_blocked : bool
  is_email_verified : bool
  created_at : timestamptz
}

entity "mentor_profiles" as mentor_profiles {
  * user_id : UUID <<PK, FK>>
  --
  headline : text <<nullable>>
  bio : text <<nullable>>
  education : text <<nullable>>
  workplace : text <<nullable>>
  languages : text[]
  verification_status : text
  is_active : bool
  rating_avg : numeric
  rating_count : int
}

entity "mentee_profiles" as mentee_profiles {
  * user_id : UUID <<PK, FK>>
  --
  background : text <<nullable>>
  goals : text[]
  skills : text[]
  interests : text[]
}

entity "topics" as topics {
  * id : UUID <<PK>>
  --
  name : text <<UQ>>
}

entity "mentor_topics" as mentor_topics {
  * mentor_id : UUID <<PK, FK>>
  * topic_id : UUID <<PK, FK>>
}

entity "mentor_services" as mentor_services {
  * id : UUID <<PK>>
  --
  mentor_id : UUID <<FK>>
  title : text
  duration_min : int
  price_amount : numeric
  currency : text
  is_active : bool
}

entity "mentorship_plans" as mentorship_plans {
  * id : UUID <<PK>>
  --
  mentor_id : UUID <<FK>>
  title : text
  kind : text
  price_amount : numeric
  currency : text
  calls_per_month : int <<nullable>>
  response_time_hours : int <<nullable>>
  is_active : bool
}

entity "mentorship_subscriptions" as mentorship_subscriptions {
  * id : UUID <<PK>>
  --
  mentor_id : UUID <<FK>>
  mentee_id : UUID <<FK>>
  plan_id : UUID <<FK>>
  status : text
  started_at : timestamptz
  next_billing_at : timestamptz <<nullable>>
}

entity "slots" as slots {
  * id : UUID <<PK>>
  --
  mentor_id : UUID <<FK>>
  start_at : timestamptz
  end_at : timestamptz
  status : text
  held_until : timestamptz <<nullable>>
}

entity "sessions" as sessions {
  * id : UUID <<PK>>
  --
  mentor_id : UUID <<FK>>
  mentee_id : UUID <<FK>>
  service_id : UUID <<FK>>
  slot_id : UUID <<FK>>
  status : text
  start_at : timestamptz
  end_at : timestamptz
  created_at : timestamptz
  canceled_at : timestamptz <<nullable>>
  cancel_reason : text <<nullable>>
}

entity "video_rooms" as video_rooms {
  * id : UUID <<PK>>
  --
  session_id : UUID <<FK>>
  provider : text
  room_id : text
  join_url_mentee : text <<nullable>>
  join_url_mentor : text <<nullable>>
}

entity "conversations" as conversations {
  * id : UUID <<PK>>
  --
  mentor_id : UUID <<FK>>
  mentee_id : UUID <<FK>>
  session_id : UUID <<FK, nullable>>
  created_at : timestamptz
  updated_at : timestamptz
}

entity "messages" as messages {
  * id : UUID <<PK>>
  --
  conversation_id : UUID <<FK>>
  sender_id : UUID <<FK>>
  content : text
  content_type : text
  is_read : bool
  created_at : timestamptz
}

entity "attachments" as attachments {
  * id : UUID <<PK>>
  --
  message_id : UUID <<FK>>
  filename : text
  url : text
  mime_type : text
  size_bytes : bigint
}

entity "payments" as payments {
  * id : UUID <<PK>>
  --
  session_id : UUID <<FK>>
  mentee_id : UUID <<FK>>
  mentor_id : UUID <<FK>>
  amount : int
  platform_fee : int
  mentor_amount : int
  currency : text
  status : text
  provider_payment_id : text <<nullable>>
  paid_at : timestamptz <<nullable>>
}

entity "payouts" as payouts {
  * id : UUID <<PK>>
  --
  mentor_id : UUID <<FK>>
  amount : numeric
  currency : text
  status : text
  provider : text
  created_at : timestamptz
}

entity "reviews" as reviews {
  * id : UUID <<PK>>
  --
  session_id : UUID <<FK>>
  mentee_id : UUID <<FK>>
  mentor_id : UUID <<FK>>
  rating : int
  text : text <<nullable>>
  created_at : timestamptz
}

entity "notifications" as notifications {
  * id : UUID <<PK>>
  --
  user_id : UUID <<FK>>
  type : text
  title : text
  body : text
  read_at : timestamptz <<nullable>>
  created_at : timestamptz
}

' layout
users -[hidden]down- mentor_profiles
users -[hidden]right- mentee_profiles
mentor_profiles -[hidden]down- mentor_topics
topics -[hidden]right- mentor_topics
mentor_profiles -[hidden]down- mentor_services
mentor_services -[hidden]right- mentorship_plans
mentor_services -[hidden]down- slots
slots -[hidden]down- sessions
sessions -[hidden]right- payments
sessions -[hidden]left- reviews
sessions -[hidden]down- conversations
conversations -[hidden]down- messages
messages -[hidden]down- attachments
video_rooms -[hidden]left- sessions
payouts -[hidden]down- notifications

' relationships
users ||--o| mentor_profiles : "профиль ментора"
users ||--o| mentee_profiles : "профиль менти"
mentor_profiles ||--o{ mentor_topics : "экспертиза"
topics ||--o{ mentor_topics : "темы"

users ||--o{ mentor_services : "услуги"
users ||--o{ mentorship_plans : "планы"
users ||--o{ mentorship_subscriptions : "как mentor"
users ||--o{ mentorship_subscriptions : "как mentee"
users ||--o{ slots : "слоты"

mentor_services ||--o{ sessions : "разовые сессии"
mentorship_plans ||--o{ mentorship_subscriptions : "покупка плана"
slots ||--o| sessions : "слот"

sessions ||--o{ payments : "оплата"
sessions ||--o| video_rooms : "видеокомната"
sessions ||--o| reviews : "отзыв"
sessions ||--o| conversations : "чат"
conversations ||--o{ messages : "сообщения"
messages ||--o{ attachments : "вложения"

users ||--o{ payouts : "выплаты"
users ||--o{ notifications : "уведомления"

legend right
  PK - основной идентификатор
  FK - ссылка на связанную запись
  UQ - уникальное значение
endlegend

@enduml
