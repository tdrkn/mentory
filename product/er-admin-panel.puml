@startuml

skinparam linetype ortho
top to bottom direction
skinparam defaultFontSize 12
skinparam ArrowFontSize 11
skinparam nodesep 70
skinparam ranksep 90

title Mentory ER (Админ-панель / Trust и операционный контур)

' As-is implementation ER.
' DOCX-отчет описывает админские операции местами как работу через стороннюю БД.
' В текущем коде это first-party trust/admin контур: /trust, /admin/trust,
' AdminJS, Prisma tables, audit logs, blocks и platform withdrawals.

entity "users" as users {
  * id : UUID <<PK>>
  --
  email : text <<UQ>>
  role : text
  is_blocked : bool
  blocked_at : timestamptz <<nullable>>
  blocked_reason : text <<nullable>>
}

entity "sessions (ref)" as sessions_ref {
  * id : UUID <<PK>>
  --
  status : text
  start_at : timestamptz
}

entity "mentor_regalia" as mentor_regalia {
  * id : UUID <<PK>>
  --
  mentor_id : UUID <<FK>>
  file_url : text
  file_name : text
  mime_type : text
  size_bytes : bigint
  status : text
  rejection_reason : text <<nullable>>
  reviewed_by_id : UUID <<FK, nullable>>
  reviewed_at : timestamptz <<nullable>>
  created_at : timestamptz
}

entity "complaints" as complaints {
  * id : UUID <<PK>>
  --
  author_id : UUID <<FK>>
  target_user_id : UUID <<FK, nullable>>
  target_session_id : UUID <<FK, nullable>>
  assigned_admin_id : UUID <<FK, nullable>>
  category : text
  occurred_at : date
  description : text
  status : text
  resolution_comment : text <<nullable>>
  created_at : timestamptz
  closed_at : timestamptz <<nullable>>
}

entity "complaint_attachments" as complaint_attachments {
  * id : UUID <<PK>>
  --
  complaint_id : UUID <<FK>>
  file_name : text
  file_url : text
  mime_type : text
  size_bytes : bigint
}

entity "complaint_messages" as complaint_messages {
  * id : UUID <<PK>>
  --
  complaint_id : UUID <<FK>>
  sender_id : UUID <<FK>>
  body : text
  created_at : timestamptz
}

entity "moderation_actions" as moderation_actions {
  * id : UUID <<PK>>
  --
  admin_id : UUID <<FK>>
  target_type : text
  target_id : UUID
  action : text
  reason : text <<nullable>>
  created_at : timestamptz
}

entity "user_blocks" as user_blocks {
  * id : UUID <<PK>>
  --
  user_id : UUID <<FK>>
  admin_id : UUID <<FK>>
  status : text
  reason : text <<nullable>>
  created_at : timestamptz
}

entity "platform_withdrawals" as platform_withdrawals {
  * id : UUID <<PK>>
  --
  admin_id : UUID <<FK>>
  amount : int
  currency : text
  provider : text
  status : text
  created_at : timestamptz
}

entity "admin_audit_logs" as admin_audit_logs {
  * id : UUID <<PK>>
  --
  admin_id : UUID <<FK>>
  action : text
  target_type : text
  target_id : UUID <<nullable>>
  created_at : timestamptz
}

' layout
users -[hidden]down- complaints
sessions_ref -[hidden]down- complaints
complaints -[hidden]down- complaint_attachments
complaint_attachments -[hidden]down- complaint_messages
complaint_messages -[hidden]down- moderation_actions
moderation_actions -[hidden]down- admin_audit_logs
mentor_regalia -[hidden]left- complaints
user_blocks -[hidden]right- admin_audit_logs

' relationships
users ||--o{ complaints : "автор / target / admin"
sessions_ref ||--o{ complaints : "контекст сессии"
complaints ||--o{ complaint_attachments : "вложения"
complaints ||--o{ complaint_messages : "переписка"
users ||--o{ complaint_messages : "отправитель"

users ||--o{ mentor_regalia : "регалии"
users ||--o{ moderation_actions : "действия"
users ||--o{ user_blocks : "блокировки"
users ||--o{ platform_withdrawals : "вывод комиссии"
users ||--o{ admin_audit_logs : "аудит"

legend right
  PK - основной идентификатор
  FK - ссылка на связанную запись
endlegend

@enduml
